use swiggy;
select * from restaurants;

-- window function
select *, 
   rank() over(order by cost desc) as 'rank',
   dense_rank() over(order by cost desc) as 'dense_rank',
   row_number() over(order by cost desc) as 'row_number',
      row_number() over(order by cost desc, rating desc) as 'number_row'

   from restaurants;
   
   -- partition by
select *,
row_number() over(partition by city order by cost desc, rating desc) as 'ranks_' from restaurants;

select * from 
(
select *, row_number() over(partition by city order by cost desc, rating desc) as 'ranks_' from restaurants
  ) as t1
   where t1.ranks_ <=10;
   
select * from 
(
select *,
 row_number() over(partition by city order by rating_count*cost desc) as 'ranks_' from restaurants
  ) as t2
   where t2.ranks_ <=10;
   
# accumulative revenue of top 10 restaurants of every city
select city, sum(cost*rating_count) from 
(
select *, 
row_number() over(partition by city order by rating_count*cost desc) as 'ranks_' from restaurants
  ) as t3
   where t3.ranks_ <=10
   group by city
   order by sum(cost*rating_count) desc
   limit 10;

