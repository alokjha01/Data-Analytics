-- substring_index
select substring_index(link,'-',-1) as id, link, name, city, rating, rating_count, cuisine, cost
   from restaurants ;

create table if not exists rest as (
   select substring_index(link,'-',-1) as id, link, name, city, rating, rating_count, cuisine, cost
   from restaurants);
 
    -- cleaning column
    
-- updating restaurant id in new column    
Drop table if exists rest1 ;
create table if not exists rest1 as
   (select substring_index(substring_index(link,'/',-1),'-',-1) as id, link, name, city, rating, rating_count, cuisine, cost
   from restaurants);
   
-- clean the name column update it on the table   
Drop table if exists rest2 ;
   create table if not exists rest2 as 
     (select id, lower(trim(name)) as name, city, rating, rating_count, cuisine, cost from rest1);
     select * from rest2 ;
     
-- clean the city column and update it on the table
Drop table if exists rest3 ;
create table rest3 as
       (select id, lower(trim(name)) as name, lower(city) as 'city', rating, rating_count, 
       lower(cuisine) as 'cuisine', cost from rest2);
select * from rest3;

-- find outliers
select cuisine, count(*) from restaurants group by cuisine
   order by count(*) asc limit 10;

-- remove the odd cuisine from the table
create table if not exists clean as 
